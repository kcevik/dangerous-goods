PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-or-anon-key>
# server only, never exposed to the browser
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# adapter-node: required in production or form actions reject every POST
ORIGIN=https://gefahrgut.org
# getClientAddress(): the reverse proxy (Caddy) sets the real client as the right-most hop
ADDRESS_HEADER=X-Forwarded-For
XFF_DEPTH=1
PORT=3000

# Absolute path to the consolidated ADR markdown file on this server.
# NOT part of the repository: deploy the file separately and point this at it.
# Keep it outside the release directory so a redeploy cannot remove it.
# The app refuses to start the ADR viewer if this is unset or the file is under 1 MB.
ADR_BOOK_PATH=/var/lib/gefahrgut/ADR2025-konsolidiert.md

# 'open' = normal sign-up; anything else (or unset) = launch-notification list (fail-closed)
REGISTRATION_MODE=waitlist
